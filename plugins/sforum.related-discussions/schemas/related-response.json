{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Related discussions response",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "cached"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topicId", "title", "slug", "categorySlug", "commentCount", "lastActivityAt"],
        "properties": {
          "topicId": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "maxLength": 512 },
          "slug": { "type": "string", "maxLength": 512 },
          "categorySlug": { "type": "string", "maxLength": 200 },
          "commentCount": { "type": "integer", "minimum": 0 },
          "lastActivityAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "cached": { "type": "boolean" }
  }
}
