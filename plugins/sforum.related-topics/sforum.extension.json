  "permissionDefinitions": [
    {
      "assignmentPolicy": "host",
      "contractVersion": "sforum.related-topics.manage@1",
      "description": {
        "en-US": "Tune similarity thresholds, limits, and index rebuild.",
        "zh-CN": "调整相关性阈值、条数与索引重建。"
      },
      "key": "sforum.related-topics.manage",
      "label": {
        "en-US": "Manage related discussions",
        "zh-CN": "管理相关讨论"
      },
      "recommendedRoles": [
        "administrator"
      ]
    }
  ],
