  "settings": {
    "fields": [
      {
        "default": "true",
        "description": {
          "en-US": "When off, the block disappears from topic pages; the index is kept.",
          "zh-CN": "关闭后帖子页不再渲染相关讨论，索引仍然保留。"
        },
        "group": "general",
        "groupId": "general",
        "key": "sforum.related-topics.enabled",
        "label": {
          "en-US": "Enable related discussions",
          "zh-CN": "启用相关讨论"
        },
        "type": "boolean"
      },
      {
        "default": "4",
        "description": {
          "en-US": "How many related topics to show under the body, 1–8.",
          "zh-CN": "正文下方最多显示几条相关帖子，1–8。"
        },
        "group": "general",
        "groupId": "general",
        "key": "sforum.related-topics.limit",
        "label": {
          "en-US": "Items shown",
          "zh-CN": "显示条数"
        },
        "placeholder": "4",
        "type": "number"
      },
      {
        "default": "0.15",
        "description": {
          "en-US": "0–1. Higher is stricter; 0.15 suits most sites.",
          "zh-CN": "0–1。越高越严格，0.15 适合大多数站点。"
        },
        "group": "general",
        "groupId": "general",
        "key": "sforum.related-topics.min_similarity",
        "label": {
          "en-US": "Minimum similarity",
          "zh-CN": "最低相似度"
        },
        "placeholder": "0.15",
        "type": "number"
      },
      {
        "default": "true",
        "description": {
          "en-US": "Restrict candidates to the same category and weight matches higher.",
          "zh-CN": "候选集只取同分类，并给同分类结果更高权重。"
        },
        "group": "general",
        "groupId": "general",
        "key": "sforum.related-topics.include_same_category",
        "label": {
          "en-US": "Prefer same category",
          "zh-CN": "同分类优先"
        },
        "type": "boolean"
      }
    ],
    "schemaVersion": 1,
    "ui": {
      "callouts": [
        {
          "body": {
            "en-US": "Four items, 0.15 threshold, same category first. Changes apply immediately.",
            "zh-CN": "4 条、0.15 阈值、同分类优先。改动后立即生效，不需要重启 API。"
          },
          "id": "recommended",
          "link": "",
          "linkLabel": "",
          "tab": "general",
          "title": {
            "en-US": "Start with the recommended defaults",
            "zh-CN": "建议先使用推荐默认值"
          },
          "tone": "info"
        }
      ],
      "groups": [
        {
          "columns": 1,
          "description": {
            "en-US": "Relevance uses title similarity and category only; bodies are never read.",
            "zh-CN": "相关性判定只看标题字面相似度与分类，不读正文。"
          },
          "id": "general",
          "label": {
            "en-US": "General",
            "zh-CN": "常规"
          }
        }
      ],
      "layout": "tabs",
      "mode": "schema",
      "tabs": [
        {
          "description": "",
          "groups": [
            "general"
          ],
          "id": "general",
          "label": {
            "en-US": "General",
            "zh-CN": "常规"
          }
        }
      ]
    }
  },
